{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/apartments", "destination": "/apartments.html" },
    { "source": "/apartments/", "destination": "/apartments/index.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/contact/", "destination": "/contact/index.html" },
    { "source": "/coming-soon", "destination": "/coming-soon.html" },
    { "source": "/coming-soon/", "destination": "/coming-soon/index.html" },
    { "source": "/apartments/:slug", "destination": "/apartments/:slug/index.html" },
    { "source": "/apartments/:slug/", "destination": "/apartments/:slug/index.html" }
  ]
}
